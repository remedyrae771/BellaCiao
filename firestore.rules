rules_version = '2';
// Правила базы для приложения кухни Bella Ciao.
// Читать и писать могут только открывшие приложение (анонимный вход Firebase),
// и только в коллекции приложения.
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{doc} {
      allow read, write: if request.auth != null
        && doc in ['staff', 'codes', 'lists', 'ttk', 'safety'];
    }
    match /shifts/{doc} { allow read, write: if request.auth != null; }
    match /checks/{doc} { allow read, write: if request.auth != null; }
    match /acks/{doc}   { allow read, write: if request.auth != null; }
  }
}
